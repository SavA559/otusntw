!
interface Loopback0
 ip address 16.16.16.16 255.255.255.255
!
interface Ethernet0/0
 description to LAN
 ip address 192.168.100.254 255.255.255.0
!
interface Ethernet0/1
 description to R18
 ip address 10.16.18.1 255.255.255.0
!
interface Ethernet0/2
 description to LAN
 ip address 192.168.108.254 255.255.255.0
!
interface Ethernet0/3
 description to R32
 ip address 10.16.32.1 255.255.255.0
!
!
router eigrp SPB-EIGRP
 !
 address-family ipv4 unicast autonomous-system 100
  !
  af-interface Ethernet0/3
   summary-address 0.0.0.0 0.0.0.0
  exit-af-interface
  !       
  topology base
  exit-af-topology
  network 10.16.18.0 0.0.0.255
  network 10.16.32.0 0.0.0.255
  network 192.168.100.0
  network 192.168.108.0
 exit-address-family
!
