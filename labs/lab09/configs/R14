router bgp 1001
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 15.15.15.15 remote-as 1001
 neighbor 15.15.15.15 update-source Loopback0
 neighbor 2001:db8::15 remote-as 1001
