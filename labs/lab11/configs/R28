!
interface Loopback0
 ip address 28.28.28.28 255.255.255.255
!
interface Tunnel100
 ip address 10.64.0.3 255.255.255.0
 ip mtu 1400
 ip nhrp map multicast 172.15.21.1
 ip nhrp map 10.64.0.1 172.15.21.1
 ip nhrp network-id 100
 ip nhrp nhs 10.64.0.1
 ip tcp adjust-mss 1360
 tunnel source Ethernet0/0
 tunnel destination 172.15.21.1
!
interface Ethernet0/0
 description "to ISP (R26)"
 ip address 172.26.28.2 255.255.255.252
 ip nat outside
 ip virtual-reassembly in
!
interface Ethernet0/1
 description "to ISP (R25)"
 ip address 172.25.28.2 255.255.255.252
 ip nat outside
 ip virtual-reassembly in
!
interface Ethernet0/2
 no ip address
 ip nat inside
 ip virtual-reassembly in
!
interface Ethernet0/2.30
 description "to LAN"
 encapsulation dot1Q 130
 ip address 192.168.130.254 255.255.255.0
 ip policy route-map PBR-LOAD-BALANCE
!
interface Ethernet0/2.31
 description "to LAN"
 encapsulation dot1Q 131
 ip address 192.168.131.254 255.255.255.0
 ip policy route-map PBR-LOAD-BALANCE
!
ip sla 1
 icmp-echo 172.26.28.1 source-interface Ethernet0/0
 threshold 1000
 timeout 1500
 frequency 4
ip sla schedule 1 life forever start-time now
ip sla 2
 icmp-echo 172.25.28.1 source-interface Ethernet0/1
 threshold 1000
 timeout 1500
 frequency 4
ip sla schedule 2 life forever start-time now
!
route-map PBR-LOAD-BALANCE permit 10
 match interface Ethernet0/2.30
 set ip next-hop verify-availability 172.26.28.1 1 track 10
!
route-map PBR-LOAD-BALANCE permit 20
 match interface Ethernet0/2.31
 set ip next-hop verify-availability 172.25.28.1 2 track 20
!
