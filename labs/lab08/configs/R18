!
interface Loopback0
 ip address 18.18.18.18 255.255.255.255
!
interface Ethernet0/0
 description to R16
 ip address 10.16.18.2 255.255.255.0
!
interface Ethernet0/1
 description to R17
 ip address 10.17.18.2 255.255.255.0
!
interface Ethernet0/2
 description to ISP (R24)
 ip address 172.18.24.1 255.255.255.252
!
interface Ethernet0/3
 description to ISP (R26)
 ip address 172.18.26.1 255.255.255.252
!
router eigrp SPB-EIGRP
 !
 address-family ipv4 unicast autonomous-system 100
  !
  topology base
  exit-af-topology
  network 10.16.18.0 0.0.0.255
  network 10.17.18.0 0.0.0.255
 exit-address-family
!
router bgp 2042
 bgp log-neighbor-changes
 neighbor 172.18.24.2 remote-as 520
 neighbor 172.18.26.2 remote-as 520
 !
 address-family ipv4
  network 172.18.24.0 mask 255.255.255.252
  network 172.18.26.0 mask 255.255.255.252
  neighbor 172.18.24.2 activate
  neighbor 172.18.26.2 activate
  neighbor 172.18.24.2 route-map RM-BGP-OUT-PREFIX out
  neighbor 172.18.26.2 route-map RM-BGP-OUT-PREFIX out
  maximum-paths 2
 exit-address-family
!
ip prefix-list PL-MY-NETS permit 142.0.0.0/24
!
route-map RM-BGP-OUT-PREFIX permit 10
 match ip address prefix-list PL-MY-NETS
!
