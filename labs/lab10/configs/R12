!
clock timezone MSK 3 0
!
ip dhcp excluded-address 192.168.101.254
!
ip dhcp pool ONE
 network 192.168.101.0 255.255.255.0
 default-router 192.168.101.254 
 dns-server 8.8.8.8 
!
interface Loopback0
 ip address 12.12.12.12 255.255.255.255
!
interface Ethernet0/0
 description to SW4
 ip address 10.4.12.2 255.255.255.0
!
interface Ethernet0/1
 description to SW5
 ip address 10.5.12.2 255.255.255.0
!
interface Ethernet0/2
 description to R14
 ip address 10.12.14.1 255.255.255.0
!
interface Ethernet0/3
 description to R15
 ip address 10.12.15.1 255.255.255.0
!
router ospf 1
 router-id 1.1.1.12
 area 10 nssa default-information-originate
 network 10.4.12.0 0.0.0.255 area 10
 network 10.5.12.0 0.0.0.255 area 10
 network 10.12.14.0 0.0.0.255 area 0
 network 10.12.15.0 0.0.0.255 area 0
!
ntp master 3
ntp update-calendar
!
