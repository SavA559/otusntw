!
clock timezone MSK 3 0
!
interface Loopback0
 ip address 1.1.1.1 255.255.255.255
!
interface Ethernet0/0
 description TO-R15
 ip address 172.1.15.1 255.255.255.252
!
interface Ethernet0/1
 description TO-R4
 ip address 192.168.14.1 255.255.255.252
!
interface Ethernet0/2
 description TO-R2
 ip address 172.1.2.1 255.255.255.252
!
interface Ethernet1/3
 description TO-R3
 ip address 172.1.3.1 255.255.255.252
!
router bgp 64511
 bgp router-id 1.1.1.1
 bgp log-neighbor-changes
 network 172.1.2.0 mask 255.255.255.252
 network 172.1.3.0 mask 255.255.255.252
 network 172.1.15.0 mask 255.255.255.252
 neighbor 4.4.4.4 remote-as 64511
 neighbor 4.4.4.4 update-source Loopback0
 neighbor 4.4.4.4 next-hop-self
 neighbor 172.1.2.2 remote-as 64512
 neighbor 172.1.3.2 remote-as 64513
 neighbor 172.1.15.2 remote-as 64501
!
ip route 4.4.4.4 255.255.255.255 192.168.14.2
!
ip access-list extended PBR-TRAFFIC
 remark "PBR FROM R15 TO R31 AND R43 TROUGH R3"
 permit ip host 172.1.15.2 host 172.4.31.2
 permit ip host 172.1.15.2 host 172.2.43.2
 deny ip any any
!
route-map TO-SPECIFIC-ROUTER permit 10
 match ip address PBR-TRAFFIC
 set ip next-hop 172.1.3.2
!
access-list 1 permit 192.168.14.2
access-list 1 permit 172.2.43.2
access-list 1 remark "permit to NTP server access"
access-list 1 permit 172.1.15.2
access-list 1 permit 172.1.3.2
access-list 1 permit 172.1.2.2
access-list 1 permit 172.4.31.2
access-list 1 permit 172.3.21.2
access-list 1 deny any
!
ntp access-group serve-only 1
ntp master 1
ntp update-calendar
!
