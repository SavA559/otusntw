!
interface Loopback0
 ip address 4.4.4.4 255.255.255.255
!
interface Ethernet0/0
 description TO-R1
 ip address 192.168.14.2 255.255.255.252
!
interface Ethernet0/1
 description TO-R31
 ip address 172.4.31.1 255.255.255.252
 ip policy route-map TO-SPECIFIC-ROUTER
!
interface Ethernet0/2
 description TO-R3
 ip address 172.3.4.2 255.255.255.252
!
interface Ethernet0/3
 description TO-R2
 ip address 172.2.4.2 255.255.255.252
!
router bgp 64511
 bgp router-id 4.4.4.4
 bgp log-neighbor-changes
 network 172.2.4.0 mask 255.255.255.252
 network 172.3.4.0 mask 255.255.255.252
 network 172.4.31.0 mask 255.255.255.252
 neighbor 1.1.1.1 remote-as 64511
 neighbor 1.1.1.1 update-source Loopback0
 neighbor 1.1.1.1 next-hop-self
 neighbor 172.2.4.1 remote-as 64512
 neighbor 172.3.4.1 remote-as 64513
 neighbor 172.4.31.2 remote-as 64501
!
no ip http server
no ip http secure-server
ip route 1.1.1.1 255.255.255.255 192.168.14.1
!
ip access-list extended PBR-TRAFFIC
 remark "PBR FROM R31 TO R15 TROUGH R3"
 permit ip host 172.4.31.2 host 172.1.15.2
 deny   ip any any
!
route-map TO-SPECIFIC-ROUTER permit 10
 match ip address PBR-TRAFFIC
 set ip next-hop 172.3.4.1
!
