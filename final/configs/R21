!
crypto ikev2 proposal GRE-PROP-PHASE1
 encryption aes-cbc-128
 integrity md5
 group 2
!
crypto ikev2 policy GRE-IKEV2-POLICY
 proposal GRE-PROP-PHASE1
!
crypto ikev2 keyring KEYRING-1
 peer ANY-SPOKE
  address 0.0.0.0 0.0.0.0
  pre-shared-key MYSECRET
!
crypto ikev2 profile GRE-IKEV2-PROFILE1
 match identity remote address 0.0.0.0
 authentication remote pre-share
 authentication local pre-share
 keyring local KEYRING-1
!
crypto ipsec transform-set GRE-TS esp-aes esp-md5-hmac
 mode transport
!
crypto ipsec profile IPSEC-PROFILE-GRE
 set transform-set GRE-TS
 set ikev2-profile GRE-IKEV2-PROFILE1
!
interface Loopback0
 ip address 21.21.21.21 255.255.255.255
!
interface Tunnel0
 description GRE to R15 via ISP1
 ip address 10.100.0.2 255.255.255.0
 ip mtu 1400
 ip tcp adjust-mss 1360
 ip ospf cost 10
 tunnel source Ethernet0/1
 tunnel destination 172.1.15.2
 tunnel protection ipsec profile IPSEC-PROFILE-GRE
!
interface Tunnel1
 description GRE to R15 via ISP2
 ip address 10.200.0.2 255.255.255.0
 ip mtu 1400
 ip tcp adjust-mss 1360
 ip ospf cost 100
 tunnel source Ethernet0/1
 tunnel destination 172.2.15.2
 tunnel protection ipsec profile IPSEC-PROFILE-GRE
!
interface Ethernet0/0
 description TO-R22
 ip address 10.2.0.5 255.255.255.252
 ip nat inside
 ip virtual-reassembly in
!
interface Ethernet0/1
 description TO-R3
 ip address 172.3.21.2 255.255.255.252
 ip nat outside
 ip virtual-reassembly in
!
interface Ethernet0/2
 description TO-R23
 ip address 10.2.0.1 255.255.255.252
 ip nat inside
 ip virtual-reassembly in
!
router eigrp BOR-EIGRP
 !
 address-family ipv4 unicast autonomous-system 100
  !
  af-interface default
   passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/0
   no passive-interface
  exit-af-interface
  !
  af-interface Ethernet0/2
   no passive-interface
  exit-af-interface
  !
  topology base
   redistribute static
   redistribute ospf 1 metric 1000 1000 255 127 1500
  exit-af-topology
  network 10.2.0.0 0.0.0.3
  network 10.2.0.4 0.0.0.3
  network 21.21.21.21 0.0.0.0
 exit-address-family
!
router ospf 1
 router-id 1.1.1.21
 redistribute eigrp 100 subnets
 network 10.100.0.0 0.0.0.255 area 0
 network 10.200.0.0 0.0.0.255 area 0
 network 21.21.21.21 0.0.0.0 area 0
!
router bgp 64502
 bgp router-id 21.21.21.21
 bgp log-neighbor-changes
 network 102.0.0.0 mask 255.255.255.0
 neighbor 172.3.21.1 remote-as 64513
!
