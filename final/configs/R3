!
interface Loopback0
 ip address 3.3.3.3 255.255.255.255
!
interface Ethernet0/0
 description TO-R2
 ip address 172.2.3.2 255.255.255.252
!
interface Ethernet0/1
 description TO-R21
 ip address 172.3.21.1 255.255.255.252
!
interface Ethernet0/2
 description TO-R4
 ip address 172.3.4.1 255.255.255.252
!
interface Ethernet0/3
 description TO-R1
 ip address 172.1.3.2 255.255.255.252
!
router bgp 64513
 bgp router-id 3.3.3.3
 bgp log-neighbor-changes
 network 172.1.3.0 mask 255.255.255.252
 network 172.2.3.0 mask 255.255.255.252
 network 172.3.4.0 mask 255.255.255.252
 network 172.3.21.0 mask 255.255.255.252
 neighbor 172.1.3.1 remote-as 64511
 neighbor 172.2.3.1 remote-as 64512
 neighbor 172.3.4.2 remote-as 64511
 neighbor 172.3.21.2 remote-as 64502
 neighbor 172.3.21.2 default-originate
 neighbor 172.3.21.2 route-map RM-BGP-OUT out
!
ip prefix-list BGP-OUT seq 10 permit 0.0.0.0/0
ip prefix-list BGP-OUT seq 20 permit 101.0.0.0/25
ip prefix-list BGP-OUT seq 30 deny 0.0.0.0/0 le 32
!
route-map RM-BGP-OUT permit 10
 match ip address prefix-list BGP-OUT
!
